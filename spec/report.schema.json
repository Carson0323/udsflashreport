{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flashreport.local/spec/report.schema.json",
  "title": "flashreport analysis report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "version", "source_file", "input_stats", "findings", "first_deviation", "summary"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "tool": {"type": "string"},
    "version": {"type": "string"},
    "source_file": {"type": "string"},
    "input_stats": {"type": "object"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "first_deviation": {"anyOf": [{"$ref": "#/$defs/finding"}, {"type": "null"}]},
    "summary": {"type": "object"},
    "workflow": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "layer", "category", "deviation_ts", "detected_ts", "observed", "expected", "suspected_side", "confidence", "session", "service", "detail", "evidence", "superseded_by", "needs_normative_confirmation"],
      "properties": {
        "finding_id": {"type": "string", "enum": ["ISO-TP-001", "ISO-TP-002", "ISO-TP-003", "ISO-TP-004", "ISO-TP-005", "UDS-001", "UDS-002", "FLASH-001"]},
        "layer": {"type": "string", "enum": ["ISO-TP", "UDS", "FLASH"]},
        "category": {"type": "string"},
        "deviation_ts": {"type": "number"},
        "detected_ts": {"type": "number"},
        "observed": {"type": "string"},
        "expected": {"type": "string"},
        "suspected_side": {"type": "string", "enum": ["tester", "ecu", "unknown"]},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "session": {"type": ["string", "null"]},
        "service": {"type": ["string", "null"]},
        "detail": {"type": "object"},
        "evidence": {"type": "array", "minItems": 2, "items": {"anyOf": [{"$ref": "#/$defs/frame_evidence"}, {"$ref": "#/$defs/window_evidence"}]}},
        "superseded_by": {"type": ["string", "null"]},
        "needs_normative_confirmation": {"type": "boolean"}
      }
    },
    "frame_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "frame_ref", "ts", "line_no", "can_id", "role", "data", "summary"],
      "properties": {
        "type": {"const": "frame"},
        "frame_ref": {"type": "string"},
        "ts": {"type": "number"},
        "line_no": {"type": "integer"},
        "can_id": {"type": "integer"},
        "role": {"type": "string"},
        "data": {"type": "string"},
        "summary": {"type": "string"}
      }
    },
    "window_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ts_start", "ts_end", "expected_role", "expected_kind", "expected_can_id", "matched_frame_count", "trace_coverage_ok", "summary"],
      "properties": {
        "type": {"const": "absence_window"},
        "ts_start": {"type": "number"},
        "ts_end": {"type": "number"},
        "expected_role": {"type": "string"},
        "expected_kind": {"type": "string"},
        "expected_can_id": {"type": ["integer", "null"]},
        "matched_frame_count": {"type": "integer", "minimum": 0},
        "trace_coverage_ok": {"type": "boolean"},
        "summary": {"type": "string"}
      }
    }
  }
}
